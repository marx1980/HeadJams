{
  "name": "music-maker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:capacitor": "tsc --noEmit && vite build --base=/",
    "cap:sync": "npm run build:capacitor && cap sync",
    "cap:build:android": "npm run build:capacitor && cap sync android && cap build android",
    "cap:build:ios": "npm run build:capacitor && cap sync ios && cap build ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
